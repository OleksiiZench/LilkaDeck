<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="LilkaDeckApp.App"
             RequestedThemeVariant="Default">
             
    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://Avalonia.Controls.ColorPicker/Themes/Fluent/Fluent.xaml" />
    </Application.Styles>

    <TrayIcon.Icons>
        <TrayIcons>
            <TrayIcon Icon="avares://LilkaDeckApp/assets/icons_source/lilka-icon.ico" 
                      ToolTipText="LilkaDeck Configurator"
                      Clicked="TrayIcon_Clicked">
                <TrayIcon.Menu>
                    <NativeMenu>
                        <NativeMenuItem Header="Показати/Сховати" Click="ToggleWindow_Clicked"/>
                        <NativeMenuItemSeparator/>
                        <NativeMenuItem Header="Вихід" Click="Exit_Clicked"/>
                    </NativeMenu>
                </TrayIcon.Menu>
            </TrayIcon>
        </TrayIcons>
    </TrayIcon.Icons>
</Application>
