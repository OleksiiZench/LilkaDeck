<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="LilkaDeckApp.MainWindow"
        Title="LilkaDeck Configurator" Width="1000" Height="650" MinWidth="950"
        RequestedThemeVariant="Dark"
        WindowStartupLocation="CenterScreen">

    <!-- Main grid: Left side for the macropad (1.5 width ratio), Right side for the menu (1 width ratio) -->
    <Grid ColumnDefinitions="1.5*, 1*">
        
        <!-- ============================================== -->
        <!-- LEFT PANEL: "LILKA" DEVICE VISUALIZATION       -->
        <!-- ============================================== -->
        <Border Grid.Column="0" Background="#1E1E1E" Padding="20">
            <Grid RowDefinitions="Auto, *">
                
                <!-- Profile Navigation Header -->
                <Grid Grid.Row="0" ColumnDefinitions="Auto, *, Auto" Margin="0,0,0,20" VerticalAlignment="Center">
                    <Button x:Name="BtnPrevProfile" Grid.Column="0" Content="◀" FontSize="20" Background="Transparent" Foreground="White" BorderThickness="0" Click="OnPrevProfileClicked"/>
                    <TextBlock x:Name="ActiveProfileTitle" Grid.Column="1" Text="Профіль 0" FontSize="24" FontWeight="Bold" Foreground="#4CAF50" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <Button x:Name="BtnNextProfile" Grid.Column="2" Content="▶" FontSize="20" Background="Transparent" Foreground="White" BorderThickness="0" Click="OnNextProfileClicked"/>
                </Grid>

                <!-- Macropad Grid -->
                <Grid Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" 
                      RowDefinitions="80, 80, 80" 
                      ColumnDefinitions="80, 80, 80, 60, 80, 80, 80">
                    
                    <!-- Left Directional Pad (D-Pad) -->
                    <Button x:Name="BtnLeftUp" Grid.Row="0" Grid.Column="1" Tag="LeftUp" Click="OnDeckButtonClicked" Classes="deck-btn" Content="UP"/>
                    <Button x:Name="BtnLeftLeft" Grid.Row="1" Grid.Column="0" Tag="LeftLeft" Click="OnDeckButtonClicked" Classes="deck-btn" Content="LEFT"/>
                    <Button x:Name="BtnLeftRight" Grid.Row="1" Grid.Column="2" Tag="LeftRight" Click="OnDeckButtonClicked" Classes="deck-btn" Content="RIGHT"/>
                    <Button x:Name="BtnLeftDown" Grid.Row="2" Grid.Column="1" Tag="LeftDown" Click="OnDeckButtonClicked" Classes="deck-btn" Content="DOWN"/>

                    <!-- Central device display -->
                    <Border Grid.Row="0" Grid.RowSpan="3" Grid.Column="3" Background="#111" CornerRadius="10" Margin="10,0"/>

                    <!-- Right Action Cluster -->
                    <Button x:Name="BtnRightUp" Grid.Row="0" Grid.Column="5" Tag="RightUp" Click="OnDeckButtonClicked" Classes="deck-btn" Content="C"/>
                    <Button x:Name="BtnRightLeft" Grid.Row="1" Grid.Column="4" Tag="RightLeft" Click="OnDeckButtonClicked" Classes="deck-btn" Content="D"/>
                    <Button x:Name="BtnRightRight" Grid.Row="1" Grid.Column="6" Tag="RightRight" Click="OnDeckButtonClicked" Classes="deck-btn" Content="A"/>
                    <Button x:Name="BtnRightDown" Grid.Row="2" Grid.Column="5" Tag="RightDown" Click="OnDeckButtonClicked" Classes="deck-btn" Content="B"/>
                </Grid>
            </Grid>
        </Border>

        <!-- ============================================== -->
        <!-- RIGHT PANEL: SETTINGS AND SYNCHRONIZATION      -->
        <!-- ============================================== -->
        <Border Grid.Column="1" Background="#2D2D30" Padding="20">
            <StackPanel Spacing="15" x:Name="SettingsPanel">
                
                <!-- 1. COM Port Connection Section -->
                <TextBlock Text="Підключення до Лілки" FontSize="20" FontWeight="Bold"/>
                <TextBlock x:Name="ConnectionStatusText" Text="Статус: Пошук пристрою..." Foreground="#FFA500" FontSize="16" FontWeight="SemiBold" Margin="0,5,0,0"/>

                <Separator Background="#555" Margin="0,5"/>

                <!-- 2. Global Profile Settings -->
                <TextBlock Text="Налаштування профілю" FontSize="20" FontWeight="Bold"/>
                <Grid ColumnDefinitions="Auto, *" RowDefinitions="Auto, Auto">
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Назва:" VerticalAlignment="Center" Margin="0,0,10,10"/>
                    <TextBox x:Name="ProfileNameTextBox" Grid.Row="0" Grid.Column="1" Text="Main Deck" MaxLength="15" PlaceholderText="До 15 символів" Margin="0,0,0,10" TextChanged="OnProfileNameChanged"/>
                    <!-- Color picker for the active button border feedback -->
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Колір відгуку:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <ColorPicker x:Name="ActiveColorPicker" Grid.Row="1" Grid.Column="1" Color="#00FFFF" HorizontalAlignment="Left" ColorChanged="OnActiveColorChanged"/>
                </Grid>

                <Separator Background="#555" Margin="0,5"/>
                
                <!-- 3. Dynamic button settings panel (activated by clicking on the left panel) -->
                <StackPanel x:Name="ButtonSettingsPanel" Spacing="12" IsEnabled="False">
                    <TextBlock x:Name="SelectedButtonLabel" Text="Оберіть кнопку..." Foreground="#4CAF50" FontSize="16" FontWeight="SemiBold"/>
                    
                    <TextBlock Text="Іконка (PNG, JPG):"/>
                    <Grid ColumnDefinitions="*, Auto">
                        <TextBox x:Name="IconPathTextBox" Grid.Column="0" IsReadOnly="True" PlaceholderText="Шлях до файлу..." Margin="0,0,10,0"/>
                        <Button Grid.Column="1" Content="Огляд..." Click="OnBrowseIconClicked"/>
                    </Grid>

                    <TextBlock Text="Тип дії:" Margin="0,5,0,0"/>
                    <ComboBox x:Name="ActionTypeComboBox" HorizontalAlignment="Stretch" SelectionChanged="OnActionTypeChanged">
                        <ComboBoxItem Content="Гарячі клавіші (Shortcut)" Tag="shortcut"/>
                        <ComboBoxItem Content="Запуск програми / URL (Launch)" Tag="launch"/>
                    </ComboBox>

                    <TextBlock x:Name="ActionHintTextBlock" Text="Дії (через кому):" Margin="0,5,0,0"/>
                    <TextBox x:Name="ActionsTextBox" PlaceholderText="CTRL, ALT, T" TextChanged="OnActionsTextChanged"/>
                </StackPanel>

                <!-- 4. Profile Management (ESP32) -->
                <TextBlock Text="Керування профілями" FontSize="20" FontWeight="Bold"/>
                <Grid ColumnDefinitions="*, Auto, Auto">
                    <TextBlock Grid.Column="0" Text="Додати / Видалити:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                
                    <!-- Add button -->
                    <Button x:Name="AddProfileButton" Grid.Column="1" Content="+" Width="32" Height="32" 
                            HorizontalContentAlignment="Center" VerticalContentAlignment="Center" 
                            Background="#4CAF50" Foreground="White" FontWeight="Bold" 
                            Click="OnAddProfileClicked" Margin="0,0,5,0" IsEnabled="False"/>
                    
                    <!-- Delete button -->
                    <Button x:Name="DeleteProfileButton" Grid.Column="2" Content="✕" Width="32" Height="32" 
                            HorizontalContentAlignment="Center" VerticalContentAlignment="Center" 
                            Background="#D32F2F" Foreground="White" FontWeight="Bold" 
                            Click="OnDeleteProfileClicked" IsEnabled="False"/>
                </Grid>
                
                <!-- File transfer progress bar -->
                <ProgressBar x:Name="SyncProgressBar" Height="10" Minimum="0" Maximum="100" Value="0" Margin="0,5,0,0"/>

                <!-- 5. Event Log -->
                <TextBlock Text="Журнал подій" FontSize="20" FontWeight="Bold" Margin="0,10,0,5"/>
                <TextBox x:Name="LogTextBox" Height="120" IsReadOnly="True" TextWrapping="Wrap" Background="#1E1E1E" Foreground="#AAA" FontFamily="Consolas" ScrollViewer.VerticalScrollBarVisibility="Auto"/>

            </StackPanel>
        </Border>

    </Grid>

    <!-- Global styles for virtual macropad buttons -->
    <Window.Styles>
        <Style Selector="Button.deck-btn">
            <Setter Property="Width" Value="64"/>
            <Setter Property="Height" Value="64"/>
            <Setter Property="CornerRadius" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Background" Value="#333"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
        <Style Selector="Button.deck-btn:pointerover /template/ ContentPresenter">
            <Setter Property="BorderBrush" Value="#4CAF50"/>
        </Style>
    </Window.Styles>
</Window>
