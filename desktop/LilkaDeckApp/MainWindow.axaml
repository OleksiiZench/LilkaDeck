<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="using:LilkaDeckApp.Converters"
        x:Class="LilkaDeckApp.MainWindow"
        xmlns:vm="using:LilkaDeckApp.ViewModels"
        x:DataType="vm:MainViewModel"
        Title="LilkaDeck Configurator" 
        Width="1250" Height="830" MinWidth="1150"
        RequestedThemeVariant="Dark"
        WindowStartupLocation="CenterScreen"
        Icon="avares://LilkaDeckApp/assets/icons_source/lilka-icon.ico">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*" MinWidth="250" MaxWidth="350"/>
            
            <ColumnDefinition Width="2.5*"/>
            
            <ColumnDefinition Width="1.2*" MinWidth="350" MaxWidth="420"/>
        </Grid.ColumnDefinitions>
        
        <!-- ============================================== -->
        <!-- LEFT PANEL: SYSTEM LOGS & SYNC PROGRESS        -->
        <!-- ============================================== -->
        <Border Grid.Column="0" Background="#252526" Padding="20">
            <!-- Using a StackPanel vertically centered to make it look neat and balanced -->
            <StackPanel VerticalAlignment="Center" Spacing="10">
                
                <!-- Section Header -->
                <TextBlock Text="Журнал подій" FontSize="20" FontWeight="Bold"/>
                
                <!-- Read-only console (Fixed max height so it doesn't look stretched) -->
                <TextBox x:Name="LogTextBox" Text="{Binding Activity.LogText, Mode=OneWay}" Height="300" IsReadOnly="True" TextWrapping="Wrap" Background="#1E1E1E" Foreground="#AAA" FontFamily="Consolas" ScrollViewer.VerticalScrollBarVisibility="Auto"/>

                <!-- File transfer progress visualizer (Moved from the right panel) -->
                <TextBlock Text="Прогрес синхронізації:" Foreground="#AAA" FontSize="12" Margin="0,10,0,0"/>
                <ProgressBar x:Name="SyncProgressBar" Height="10" Minimum="0" Maximum="100" Value="{Binding Activity.Progress}" HorizontalAlignment="Stretch"/>
                
            </StackPanel>
        </Border>

        <!-- ============================================== -->
        <!-- CENTRAL PANEL: "LILKA" DEVICE VISUALIZATION    -->
        <!-- ============================================== -->
        <Border Grid.Column="1" Background="#1E1E1E" Padding="20">
            <Grid RowDefinitions="Auto, *">
                
                <!-- Profile Navigation Header (Carousel controls) -->
                <Grid Grid.Row="0" ColumnDefinitions="Auto, *, Auto" Margin="0,0,0,20" VerticalAlignment="Center">
                    <!-- Previous Profile Button -->
                    <Button x:Name="BtnPrevProfile" Grid.Column="0" Content="◀" FontSize="20" Background="Transparent" Foreground="White" BorderThickness="0" Command="{Binding Profile.PreviousCommand}"/>
                    
                    <!-- Active Profile Title Display -->
                    <TextBlock x:Name="ActiveProfileTitle" Grid.Column="1" Text="{Binding Profile.Title}" FontSize="24" FontWeight="Bold" Foreground="#4CAF50" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    
                    <!-- Next Profile Button -->
                    <Button x:Name="BtnNextProfile" Grid.Column="2" Content="▶" FontSize="20" Background="Transparent" Foreground="White" BorderThickness="0" Command="{Binding Profile.NextCommand}"/>
                </Grid>

                <Viewbox Grid.Row="1" Stretch="Uniform" Margin="40" MaxWidth="750" MaxHeight="400">
                    <Grid VerticalAlignment="Center" HorizontalAlignment="Center" 
                          RowDefinitions="80, 80, 80" 
                          ColumnDefinitions="80, 80, 80, 60, 80, 80, 80">
                    
                        <!-- Left Directional Pad (D-Pad) Cluster -->
                        <Button DragDrop.AllowDrop="True" Grid.Row="0" Grid.Column="1" Classes="deck-btn" Content="{Binding Deck.LeftUp}" Command="{Binding Deck.LeftUp.SelectCommand}"/>
                        <Button DragDrop.AllowDrop="True" Grid.Row="1" Grid.Column="0" Classes="deck-btn" Content="{Binding Deck.LeftLeft}" Command="{Binding Deck.LeftLeft.SelectCommand}"/>
                        <Button DragDrop.AllowDrop="True" Grid.Row="1" Grid.Column="2" Classes="deck-btn" Content="{Binding Deck.LeftRight}" Command="{Binding Deck.LeftRight.SelectCommand}"/>
                        <Button DragDrop.AllowDrop="True" Grid.Row="2" Grid.Column="1" Classes="deck-btn" Content="{Binding Deck.LeftDown}" Command="{Binding Deck.LeftDown.SelectCommand}"/>
                        
                        <!-- Central TFT Display Placeholder -->
                        <Border Grid.Row="0" Grid.RowSpan="3" Grid.Column="3" Background="#111" CornerRadius="10" Margin="10,0"/>

                        <!-- Right Action Button Cluster -->
                        <Button DragDrop.AllowDrop="True" Grid.Row="0" Grid.Column="5" Classes="deck-btn" Content="{Binding Deck.RightUp}" Command="{Binding Deck.RightUp.SelectCommand}"/>
                        <Button DragDrop.AllowDrop="True" Grid.Row="1" Grid.Column="4" Classes="deck-btn" Content="{Binding Deck.RightLeft}" Command="{Binding Deck.RightLeft.SelectCommand}"/>
                        <Button DragDrop.AllowDrop="True" Grid.Row="1" Grid.Column="6" Classes="deck-btn" Content="{Binding Deck.RightRight}" Command="{Binding Deck.RightRight.SelectCommand}"/>
                        <Button DragDrop.AllowDrop="True" Grid.Row="2" Grid.Column="5" Classes="deck-btn" Content="{Binding Deck.RightDown}" Command="{Binding Deck.RightDown.SelectCommand}"/>
                        
                        </Grid>
                </Viewbox>
            </Grid>
        </Border>

        <!-- ============================================== -->
        <!-- RIGHT PANEL: SETTINGS AND SYNCHRONIZATION      -->
        <!-- ============================================== -->
        <Border Grid.Column="2" Background="#2D2D30" Padding="20">
            <StackPanel Spacing="15" x:Name="SettingsPanel">
                
                <!-- 1. Serial Port Connection Status -->
                <TextBlock Text="Підключення до Лілки" FontSize="20" FontWeight="Bold"/>
                <TextBlock x:Name="ConnectionStatusText" Classes="status" Classes.connected="{Binding Connection.IsConnected}" Classes.error="{Binding Connection.IsError}" Text="{Binding Connection.StatusText}" FontSize="16" FontWeight="SemiBold" Margin="0,5,0,0"/>

                <Separator Background="#555" Margin="0,5"/>

                <!-- 2. Global Profile Configuration -->
                <TextBlock Text="Налаштування профілю" FontSize="20" FontWeight="Bold"/>
                <Grid ColumnDefinitions="Auto, *" RowDefinitions="Auto, Auto">
                    <!-- Custom Profile Name Input -->
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Назва:" VerticalAlignment="Center" Margin="0,0,10,10"/>
                    <TextBox x:Name="ProfileNameTextBox" Grid.Row="0" Grid.Column="1" MaxLength="15" PlaceholderText="До 15 символів" Margin="0,0,0,10" Text="{Binding Profile.Name}"/>
                    
                    <!-- Color picker for active button feedback (Triggers Live Preview via ESP32 RAM) -->
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Колір відгуку:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <ColorPicker x:Name="ActiveColorPicker" Grid.Row="1" Grid.Column="1" HorizontalAlignment="Left" Color="{Binding Profile.ActiveColor, Converter={x:Static conv:HexColorConverter.Instance}}"/>
                </Grid>

                <Separator Background="#555" Margin="0,5"/>
                
                <!-- 3. Dynamic Button Settings Panel (Enabled only when a virtual button is clicked) -->
                <StackPanel x:Name="ButtonSettingsPanel" Spacing="12" IsEnabled="{Binding Editor.HasSelection}">
    <TextBlock x:Name="SelectedButtonLabel" Text="{Binding Editor.Header}" Foreground="#4CAF50" FontSize="16" FontWeight="SemiBold"/>
    
    <TextBlock Text="Іконка (PNG, JPG):"/>
    <Grid ColumnDefinitions="*, Auto, Auto">
    <TextBox x:Name="IconPathTextBox" Grid.Column="0" IsReadOnly="True" Text="{Binding Editor.IconFileName, Mode=OneWay}" PlaceholderText="Шлях до файлу..." Margin="0,0,10,0"/>
    
    <Button x:Name="GalleryButton" Grid.Column="1" Content="Галерея" Command="{Binding Icons.Gallery.OpenCommand}" Margin="0,0,5,0"/>
    <Popup PlacementTarget="{Binding #GalleryButton}" Placement="Bottom" IsLightDismissEnabled="True"
           IsOpen="{Binding Icons.Gallery.IsOpen, Mode=TwoWay}">
        <Border Background="#2D2D30" BorderBrush="#555" BorderThickness="1" CornerRadius="6" Padding="6">
            <ScrollViewer MaxHeight="300" MaxWidth="300">
                <ItemsControl ItemsSource="{Binding Icons.Gallery.Items}" MaxWidth="280">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:GalleryIconViewModel">
                            <Button Width="60" Height="60" Margin="2" Padding="6" Background="#333" Command="{Binding SelectCommand}">
                                <Image Stretch="Uniform" RenderOptions.BitmapInterpolationMode="HighQuality"
                                       Source="{Binding FilePath, Converter={x:Static conv:ThumbnailBitmapConverter.Instance}}"/>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>
    </Popup>
    
    <Button Grid.Column="2" Content="Огляд..." Command="{Binding Icons.BrowseCommand}"/>
</Grid>
    
    <TextBlock Text="Тип дії:" Margin="0,5,0,0"/>
    <ComboBox x:Name="ActionTypeComboBox" HorizontalAlignment="Stretch"
              ItemsSource="{Binding Editor.ActionTypeOptions}" SelectedItem="{Binding Editor.SelectedActionType}">
        <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="vm:ActionTypeOption">
                <TextBlock Text="{Binding Title}"/>
            </DataTemplate>
        </ComboBox.ItemTemplate>
    </ComboBox>
    
    <TextBlock x:Name="ActionHintTextBlock" Text="{Binding Editor.ActionHint}" Margin="0,5,0,0"/>
    <TextBox x:Name="ActionsTextBox" Text="{Binding Editor.ActionText}"
             PlaceholderText="{Binding Editor.ActionPlaceholder}" IsReadOnly="{Binding Editor.IsActionReadOnly}"/>
    <TextBlock Text="Або оберіть медіа-дію:" IsVisible="{Binding Editor.AreMediaButtonsVisible}" Foreground="#888" FontSize="12" Margin="0,5,0,0"/>
    <WrapPanel x:Name="MediaButtonsPanel" IsVisible="{Binding Editor.AreMediaButtonsVisible}">
                            <Button Content="⏯ Play/Pause" Command="{Binding Editor.MediaCommand}" CommandParameter="MEDIA_PLAY_PAUSE" Margin="0,0,4,4"/>
                            <Button Content="⏭ Next" Command="{Binding Editor.MediaCommand}" CommandParameter="MEDIA_NEXT" Margin="0,0,4,4"/>
                            <Button Content="⏮ Prev" Command="{Binding Editor.MediaCommand}" CommandParameter="MEDIA_PREV" Margin="0,0,4,4"/>
                            <Button Content="🔊 Vol+" Command="{Binding Editor.MediaCommand}" CommandParameter="MEDIA_VOL_UP" Margin="0,0,4,4"/>
                            <Button Content="🔉 Vol-" Command="{Binding Editor.MediaCommand}" CommandParameter="MEDIA_VOL_DOWN" Margin="0,0,4,4"/>
                            <Button Content="🔇 Mute" Command="{Binding Editor.MediaCommand}" CommandParameter="MEDIA_MUTE" Margin="0,0,4,4"/>
                            <Button Content="☀ Brightness+" Command="{Binding Editor.MediaCommand}" CommandParameter="MEDIA_BRIGHTNESS_UP" Margin="0,0,4,4"/>
                            <Button Content="🔅 Brightness-" Command="{Binding Editor.MediaCommand}" CommandParameter="MEDIA_BRIGHTNESS_DOWN" Margin="0,0,4,4"/>
                        </WrapPanel>
                </StackPanel>

                <Separator Background="#555" Margin="0,5"/>

                <!-- 4. Profile Management & USB CDC Sync -->
                <TextBlock Text="Керування профілями" FontSize="20" FontWeight="Bold"/>
                <Grid ColumnDefinitions="*, Auto, Auto">
                    <TextBlock Grid.Column="0" Text="Додати / Видалити:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                
                    <!-- Create New Profile Button (+) -->
                    <Button x:Name="AddProfileButton" Grid.Column="1" Content="+" Width="32" Height="32" 
                            HorizontalContentAlignment="Center" VerticalContentAlignment="Center" 
                            Background="#4CAF50" Foreground="White" FontWeight="Bold" 
                            Margin="0,0,5,0" Command="{Binding Profile.AddCommand}"/>
                    
                    <!-- Delete Current Profile Button (✕) -->
                    <Button x:Name="DeleteProfileButton" Grid.Column="2" Content="✕" Width="32" Height="32" 
                            HorizontalContentAlignment="Center" VerticalContentAlignment="Center" 
                            Background="#D32F2F" Foreground="White" FontWeight="Bold" 
                            Command="{Binding Profile.DeleteCommand}"/>
                </Grid>

            </StackPanel>
        </Border>

    </Grid>

    <!-- ============================================== -->
    <!-- GLOBAL UI STYLES                               -->
    <!-- ============================================== -->
    <Window.Styles>
        <!-- Base style for virtual macropad buttons -->
        <Style Selector="Button.deck-btn">
            <!-- 1. Збільшуємо розмір самої кнопки (було 64) -->
            <Setter Property="Width" Value="74"/>
            <Setter Property="Height" Value="74"/>
            <Setter Property="CornerRadius" Value="12"/> 
            <Setter Property="ClipToBounds" Value="True"/> 
            
            <!-- 2. Додаємо внутрішній відступ, щоб відірвати іконку від рамки -->
            <Setter Property="Padding" Value="5"/>
            
            <!-- 3. Робимо рамку товщою (було 1) та трохи світлішою для контрасту -->
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="BorderBrush" Value="#555"/> 
            
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Background" Value="#000000"/> 
            <Setter Property="Foreground" Value="#888"/> 
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontWeight" Value="Bold"/>

            <Setter Property="ContentTemplate">
                <DataTemplate x:DataType="vm:DeckButtonViewModel">
                    <Panel>
                    <TextBlock Text="{Binding DefaultLabel}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <Border CornerRadius="4" ClipToBounds="True">
                        <Image Stretch="UniformToFill" RenderOptions.BitmapInterpolationMode="HighQuality"
                            Source="{Binding IconFilePath, Converter={x:Static conv:IconBitmapConverter.Instance}}"/>
                    </Border>
                    </Panel>
                </DataTemplate>
                </Setter>
        </Style>
        
        <!-- Hover state for virtual macropad buttons -->
        <Style Selector="Button.deck-btn:pointerover /template/ ContentPresenter">
            <!-- Зберігаємо товщину рамки при наведенні, змінюємо лише колір -->
            <Setter Property="BorderBrush" Value="#4CAF50"/>
            <Setter Property="Background" Value="#000000"/>
        </Style>

        <Style Selector="TextBlock.status"><Setter Property="Foreground" Value="#FFA500"/></Style>
        <Style Selector="TextBlock.status.connected"><Setter Property="Foreground" Value="#4CAF50"/></Style>
        <Style Selector="TextBlock.status.error"><Setter Property="Foreground" Value="#FF5252"/></Style>
    </Window.Styles>
</Window>
