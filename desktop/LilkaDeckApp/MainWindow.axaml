<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="LilkaDeckApp.MainWindow"
        Title="LilkaDeck Configurator" Width="1000" Height="600" MinWidth="950"
        RequestedThemeVariant="Dark"
        WindowStartupLocation="CenterScreen">

    <Grid ColumnDefinitions="1.5*, 1*">
        
        <!-- LEFT SIDE: Lilka Device Visualization -->
        <Border Grid.Column="0" Background="#1E1E1E" Padding="20">
            <Grid VerticalAlignment="Center" HorizontalAlignment="Center" 
                  RowDefinitions="80, 80, 80" 
                  ColumnDefinitions="80, 80, 80, 60, 80, 80, 80">
                
                <Button Grid.Row="0" Grid.Column="1" Tag="LeftUp" Click="OnDeckButtonClicked" Classes="deck-btn" Content="UP"/>
                <Button Grid.Row="1" Grid.Column="0" Tag="LeftLeft" Click="OnDeckButtonClicked" Classes="deck-btn" Content="LEFT"/>
                <Button Grid.Row="1" Grid.Column="2" Tag="LeftRight" Click="OnDeckButtonClicked" Classes="deck-btn" Content="RIGHT"/>
                <Button Grid.Row="2" Grid.Column="1" Tag="LeftDown" Click="OnDeckButtonClicked" Classes="deck-btn" Content="DOWN"/>

                <Border Grid.Row="0" Grid.RowSpan="3" Grid.Column="3" Background="#111" CornerRadius="10" Margin="10,0"/>

                <Button Grid.Row="0" Grid.Column="5" Tag="RightUp" Click="OnDeckButtonClicked" Classes="deck-btn" Content="C"/>
                <Button Grid.Row="1" Grid.Column="4" Tag="RightLeft" Click="OnDeckButtonClicked" Classes="deck-btn" Content="D"/>
                <Button Grid.Row="1" Grid.Column="6" Tag="RightRight" Click="OnDeckButtonClicked" Classes="deck-btn" Content="A"/>
                <Button Grid.Row="2" Grid.Column="5" Tag="RightDown" Click="OnDeckButtonClicked" Classes="deck-btn" Content="B"/>
            </Grid>
        </Border>

        <!-- RIGHT SIDE: Settings Panel -->
        <Border Grid.Column="1" Background="#2D2D30" Padding="20">
            <StackPanel Spacing="15" x:Name="SettingsPanel">
                
                <!-- Панель підключення COM-порту -->
                <TextBlock Text="Підключення до Лілки" FontSize="20" FontWeight="Bold"/>
                <Grid ColumnDefinitions="*, Auto, Auto">
                    <ComboBox x:Name="ComPortComboBox" Grid.Column="0" HorizontalAlignment="Stretch" Margin="0,0,10,0"/>
                    <Button x:Name="ConnectButton" Grid.Column="1" Content="Підключити" Background="#4CAF50" Click="OnConnectButtonClicked" Margin="0,0,5,0"/>
                    <Button Grid.Column="2" Content="↻" Background="#555" Click="OnRefreshPortsClicked"/>
                </Grid>
                <TextBlock x:Name="ConnectionStatusText" Text="Статус: Відключено" Foreground="#FF5252" FontWeight="SemiBold"/>

                <Separator Background="#555" Margin="0,5"/>

                <!-- Налаштування профілю -->
                <TextBlock Text="Налаштування профілю" FontSize="20" FontWeight="Bold"/>
                <Grid ColumnDefinitions="Auto, *">
                    <TextBlock Grid.Column="0" Text="Назва:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBox x:Name="ProfileNameTextBox" Grid.Column="1" Text="Main Deck" MaxLength="15" PlaceholderText="До 15 символів"/>
                </Grid>

                <Separator Background="#555" Margin="0,5"/>
                
                <!-- Button Settings Panel -->
                <StackPanel x:Name="ButtonSettingsPanel" Spacing="12" IsEnabled="False">
                    <TextBlock x:Name="SelectedButtonLabel" Text="Оберіть кнопку..." Foreground="#4CAF50" FontSize="16" FontWeight="SemiBold"/>
                    
                    <TextBlock Text="Іконка (PNG, JPG):"/>
                    <Grid ColumnDefinitions="*, Auto">
                        <TextBox x:Name="IconPathTextBox" Grid.Column="0" IsReadOnly="True" PlaceholderText="Шлях до файлу..." Margin="0,0,10,0"/>
                        <Button Grid.Column="1" Content="Огляд..." Click="OnBrowseIconClicked"/>
                    </Grid>

                    <TextBlock Text="Тип дії:" Margin="0,5,0,0"/>
                    <ComboBox x:Name="ActionTypeComboBox" HorizontalAlignment="Stretch" SelectionChanged="OnActionTypeChanged">
                        <ComboBoxItem Content="Гарячі клавіші (Shortcut)" Tag="shortcut"/>
                        <ComboBoxItem Content="Запуск програми / URL (Launch)" Tag="launch"/>
                    </ComboBox>

                    <TextBlock x:Name="ActionHintTextBlock" Text="Дії (через кому):" Margin="0,5,0,0"/>
                    <TextBox x:Name="ActionsTextBox" PlaceholderText="CTRL, ALT, T" TextChanged="OnActionsTextChanged"/>
                </StackPanel>

                <!-- Save JSON Button (Local) -->
                <Button Content="Зберегти config.json локально" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" 
                        Margin="0,10,0,0" Background="#333" Click="OnGenerateJsonClicked"/>

                <Separator Background="#555" Margin="0,10"/>

                <!-- NEW: Синхронізація -->
                <TextBlock Text="Синхронізація (PC -> ESP32)" FontSize="20" FontWeight="Bold"/>
                <Grid ColumnDefinitions="Auto, *, Auto">
                    <TextBlock Grid.Column="0" Text="ID Профілю:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <NumericUpDown x:Name="ProfileIdSpinner" Grid.Column="1" Value="0" Minimum="0" Maximum="99" Margin="0,0,10,0"/>
                    <Button x:Name="SyncButton" Grid.Column="2" Content="Синхронізувати" Background="#E65100" Click="OnSyncButtonClicked" IsEnabled="False"/>
                </Grid>
                <ProgressBar x:Name="SyncProgressBar" Height="10" Minimum="0" Maximum="100" Value="0" Margin="0,5,0,0"/>
                <TextBlock x:Name="SyncStatusText" Text="Очікування підключення..." Foreground="#AAA" HorizontalAlignment="Center"/>

            </StackPanel>
        </Border>

    </Grid>

    <Window.Styles>
        <Style Selector="Button.deck-btn">
            <Setter Property="Width" Value="70"/>
            <Setter Property="Height" Value="70"/>
            <Setter Property="CornerRadius" Value="35"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Background" Value="#333"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
        <Style Selector="Button.deck-btn:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#4CAF50"/>
        </Style>
    </Window.Styles>
</Window>
