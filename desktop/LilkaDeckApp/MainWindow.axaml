<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="LilkaDeckApp.MainWindow"
        Title="LilkaDeck Configurator" 
        Width="1250" Height="670" MinWidth="1150"
        RequestedThemeVariant="Dark"
        WindowStartupLocation="CenterScreen"
        Icon="avares://LilkaDeckApp/assets/icons_source/lilka-icon.ico">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*" MinWidth="250" MaxWidth="350"/>
            
            <ColumnDefinition Width="2.5*"/>
            
            <ColumnDefinition Width="1.2*" MinWidth="350" MaxWidth="420"/>
        </Grid.ColumnDefinitions>
        
        <!-- ============================================== -->
        <!-- LEFT PANEL: SYSTEM LOGS & SYNC PROGRESS        -->
        <!-- ============================================== -->
        <Border Grid.Column="0" Background="#252526" Padding="20">
            <!-- Using a StackPanel vertically centered to make it look neat and balanced -->
            <StackPanel VerticalAlignment="Center" Spacing="10">
                
                <!-- Section Header -->
                <TextBlock Text="Журнал подій" FontSize="20" FontWeight="Bold"/>
                
                <!-- Read-only console (Fixed max height so it doesn't look stretched) -->
                <TextBox x:Name="LogTextBox" Height="300" IsReadOnly="True" TextWrapping="Wrap" Background="#1E1E1E" Foreground="#AAA" FontFamily="Consolas" ScrollViewer.VerticalScrollBarVisibility="Auto"/>
                
                <!-- File transfer progress visualizer (Moved from the right panel) -->
                <TextBlock Text="Прогрес синхронізації:" Foreground="#AAA" FontSize="12" Margin="0,10,0,0"/>
                <ProgressBar x:Name="SyncProgressBar" Height="10" Minimum="0" Maximum="100" Value="0" HorizontalAlignment="Stretch"/>
                
            </StackPanel>
        </Border>

        <!-- ============================================== -->
        <!-- CENTRAL PANEL: "LILKA" DEVICE VISUALIZATION    -->
        <!-- ============================================== -->
        <Border Grid.Column="1" Background="#1E1E1E" Padding="20">
            <Grid RowDefinitions="Auto, *">
                
                <!-- Profile Navigation Header (Carousel controls) -->
                <Grid Grid.Row="0" ColumnDefinitions="Auto, *, Auto" Margin="0,0,0,20" VerticalAlignment="Center">
                    <!-- Previous Profile Button -->
                    <Button x:Name="BtnPrevProfile" Grid.Column="0" Content="◀" FontSize="20" Background="Transparent" Foreground="White" BorderThickness="0" Click="OnPrevProfileClicked"/>
                    
                    <!-- Active Profile Title Display -->
                    <TextBlock x:Name="ActiveProfileTitle" Grid.Column="1" Text="Профіль 0" FontSize="24" FontWeight="Bold" Foreground="#4CAF50" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    
                    <!-- Next Profile Button -->
                    <Button x:Name="BtnNextProfile" Grid.Column="2" Content="▶" FontSize="20" Background="Transparent" Foreground="White" BorderThickness="0" Click="OnNextProfileClicked"/>
                </Grid>

                <Viewbox Grid.Row="1" Stretch="Uniform" Margin="40" MaxWidth="750" MaxHeight="400">
                    <Grid VerticalAlignment="Center" HorizontalAlignment="Center" 
                          RowDefinitions="80, 80, 80" 
                          ColumnDefinitions="80, 80, 80, 60, 80, 80, 80">
                    
                        <!-- Left Directional Pad (D-Pad) Cluster -->
                        <Button x:Name="BtnLeftUp" DragDrop.AllowDrop="True" Grid.Row="0" Grid.Column="1" Tag="LeftUp" Click="OnDeckButtonClicked" Classes="deck-btn" Content="UP"/>
                        <Button x:Name="BtnLeftLeft" DragDrop.AllowDrop="True" Grid.Row="1" Grid.Column="0" Tag="LeftLeft" Click="OnDeckButtonClicked" Classes="deck-btn" Content="LEFT"/>
                        <Button x:Name="BtnLeftRight" DragDrop.AllowDrop="True" Grid.Row="1" Grid.Column="2" Tag="LeftRight" Click="OnDeckButtonClicked" Classes="deck-btn" Content="RIGHT"/>
                        <Button x:Name="BtnLeftDown" DragDrop.AllowDrop="True" Grid.Row="2" Grid.Column="1" Tag="LeftDown" Click="OnDeckButtonClicked" Classes="deck-btn" Content="DOWN"/>

                        <!-- Central TFT Display Placeholder -->
                        <Border Grid.Row="0" Grid.RowSpan="3" Grid.Column="3" Background="#111" CornerRadius="10" Margin="10,0"/>

                        <!-- Right Action Button Cluster -->
                        <Button x:Name="BtnRightUp" DragDrop.AllowDrop="True" Grid.Row="0" Grid.Column="5" Tag="RightUp" Click="OnDeckButtonClicked" Classes="deck-btn" Content="C"/>
                        <Button x:Name="BtnRightLeft" DragDrop.AllowDrop="True" Grid.Row="1" Grid.Column="4" Tag="RightLeft" Click="OnDeckButtonClicked" Classes="deck-btn" Content="D"/>
                        <Button x:Name="BtnRightRight" DragDrop.AllowDrop="True" Grid.Row="1" Grid.Column="6" Tag="RightRight" Click="OnDeckButtonClicked" Classes="deck-btn" Content="A"/>
                        <Button x:Name="BtnRightDown" DragDrop.AllowDrop="True" Grid.Row="2" Grid.Column="5" Tag="RightDown" Click="OnDeckButtonClicked" Classes="deck-btn" Content="B"/>
                    </Grid>
                </Viewbox>
            </Grid>
        </Border>

        <!-- ============================================== -->
        <!-- RIGHT PANEL: SETTINGS AND SYNCHRONIZATION      -->
        <!-- ============================================== -->
        <Border Grid.Column="2" Background="#2D2D30" Padding="20">
            <StackPanel Spacing="15" x:Name="SettingsPanel">
                
                <!-- 1. Serial Port Connection Status -->
                <TextBlock Text="Підключення до Лілки" FontSize="20" FontWeight="Bold"/>
                <TextBlock x:Name="ConnectionStatusText" Text="Статус: Пошук пристрою..." Foreground="#FFA500" FontSize="16" FontWeight="SemiBold" Margin="0,5,0,0"/>

                <Separator Background="#555" Margin="0,5"/>

                <!-- 2. Global Profile Configuration -->
                <TextBlock Text="Налаштування профілю" FontSize="20" FontWeight="Bold"/>
                <Grid ColumnDefinitions="Auto, *" RowDefinitions="Auto, Auto">
                    <!-- Custom Profile Name Input -->
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Назва:" VerticalAlignment="Center" Margin="0,0,10,10"/>
                    <TextBox x:Name="ProfileNameTextBox" Grid.Row="0" Grid.Column="1" Text="Main Deck" MaxLength="15" PlaceholderText="До 15 символів" Margin="0,0,0,10" TextChanged="OnProfileNameChanged"/>
                    
                    <!-- Color picker for active button feedback (Triggers Live Preview via ESP32 RAM) -->
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Колір відгуку:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <ColorPicker x:Name="ActiveColorPicker" Grid.Row="1" Grid.Column="1" Color="#00FFFF" HorizontalAlignment="Left" ColorChanged="OnActiveColorChanged"/>
                </Grid>

                <Separator Background="#555" Margin="0,5"/>
                
                <!-- 3. Dynamic Button Settings Panel (Enabled only when a virtual button is clicked) -->
                <StackPanel x:Name="ButtonSettingsPanel" Spacing="12" IsEnabled="False">
                    <TextBlock x:Name="SelectedButtonLabel" Text="Оберіть кнопку..." Foreground="#4CAF50" FontSize="16" FontWeight="SemiBold"/>
                    
                    <!-- Icon Selection -->
                    <TextBlock Text="Іконка (PNG, JPG):"/>
                    <Grid ColumnDefinitions="*, Auto, Auto">
                        <TextBox x:Name="IconPathTextBox" Grid.Column="0" IsReadOnly="True" PlaceholderText="Шлях до файлу..." Margin="0,0,10,0"/>
                        
                        <!-- Gallery Button -->
                        <Button x:Name="GalleryButton" Grid.Column="1" Content="Галерея" Click="OnGalleryClicked" Margin="0,0,5,0">
                            <Button.Flyout>
                                <Flyout Placement="Bottom">
                                    <ScrollViewer MaxHeight="300" MaxWidth="300">
                                        <WrapPanel x:Name="GalleryWrapPanel" ItemWidth="64" ItemHeight="64" MaxWidth="280">
                                            <!-- Standard icons will be dynamically injected here via C# -->
                                        </WrapPanel>
                                    </ScrollViewer>
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                        
                        <Button Grid.Column="2" Content="Огляд..." Click="OnBrowseIconClicked"/>
                    </Grid>

                    <!-- Action Type Dropdown (Shortcut vs Launch) -->
                    <TextBlock Text="Тип дії:" Margin="0,5,0,0"/>
                    <ComboBox x:Name="ActionTypeComboBox" HorizontalAlignment="Stretch" SelectionChanged="OnActionTypeChanged">
                        <ComboBoxItem Content="Гарячі клавіші (Shortcut)" Tag="shortcut"/>
                        <ComboBoxItem Content="Запуск програми / URL (Launch)" Tag="launch"/>
                    </ComboBox>

                    <!-- Action Payload Input -->
                    <TextBlock x:Name="ActionHintTextBlock" Text="Дії (через кому):" Margin="0,5,0,0"/>
                    <TextBox x:Name="ActionsTextBox" PlaceholderText="CTRL, ALT, T" TextChanged="OnActionsTextChanged" KeyDown="OnActionsTextBoxKeyDown"/>
                    <TextBlock Text="Або оберіть медіа-дію:" Foreground="#888" FontSize="12" Margin="0,5,0,0"/>
                        <WrapPanel x:Name="MediaButtonsPanel">
                            <Button Content="⏯ Play/Pause" Tag="MEDIA_PLAY_PAUSE" Click="OnMediaButtonClicked" Margin="0,0,4,4"/>
                            <Button Content="⏭ Next" Tag="MEDIA_NEXT" Click="OnMediaButtonClicked" Margin="0,0,4,4"/>
                            <Button Content="⏮ Prev" Tag="MEDIA_PREV" Click="OnMediaButtonClicked" Margin="0,0,4,4"/>
                            <Button Content="🔊 Vol+" Tag="MEDIA_VOL_UP" Click="OnMediaButtonClicked" Margin="0,0,4,4"/>
                            <Button Content="🔉 Vol-" Tag="MEDIA_VOL_DOWN" Click="OnMediaButtonClicked" Margin="0,0,4,4"/>
                            <Button Content="🔇 Mute" Tag="MEDIA_MUTE" Click="OnMediaButtonClicked" Margin="0,0,4,4"/>
                            <Button Content="☀ Brightness+" Tag="MEDIA_BRIGHTNESS_UP" Click="OnMediaButtonClicked" Margin="0,0,4,4"/>
                            <Button Content="🔅 Brightness-" Tag="MEDIA_BRIGHTNESS_DOWN" Click="OnMediaButtonClicked" Margin="0,0,4,4"/>
                        </WrapPanel>
                </StackPanel>

                <Separator Background="#555" Margin="0,5"/>

                <!-- 4. Profile Management & USB CDC Sync -->
                <TextBlock Text="Керування профілями" FontSize="20" FontWeight="Bold"/>
                <Grid ColumnDefinitions="*, Auto, Auto">
                    <TextBlock Grid.Column="0" Text="Додати / Видалити:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                
                    <!-- Create New Profile Button (+) -->
                    <Button x:Name="AddProfileButton" Grid.Column="1" Content="+" Width="32" Height="32" 
                            HorizontalContentAlignment="Center" VerticalContentAlignment="Center" 
                            Background="#4CAF50" Foreground="White" FontWeight="Bold" 
                            Click="OnAddProfileClicked" Margin="0,0,5,0" IsEnabled="False"/>
                    
                    <!-- Delete Current Profile Button (✕) -->
                    <Button x:Name="DeleteProfileButton" Grid.Column="2" Content="✕" Width="32" Height="32" 
                            HorizontalContentAlignment="Center" VerticalContentAlignment="Center" 
                            Background="#D32F2F" Foreground="White" FontWeight="Bold" 
                            Click="OnDeleteProfileClicked" IsEnabled="False"/>
                </Grid>

            </StackPanel>
        </Border>

    </Grid>

    <!-- ============================================== -->
    <!-- GLOBAL UI STYLES                               -->
    <!-- ============================================== -->
    <Window.Styles>
        <!-- Base style for virtual macropad buttons -->
        <Style Selector="Button.deck-btn">
            <!-- 1. Збільшуємо розмір самої кнопки (було 64) -->
            <Setter Property="Width" Value="74"/>
            <Setter Property="Height" Value="74"/>
            <Setter Property="CornerRadius" Value="12"/> 
            <Setter Property="ClipToBounds" Value="True"/> 
            
            <!-- 2. Додаємо внутрішній відступ, щоб відірвати іконку від рамки -->
            <Setter Property="Padding" Value="5"/>
            
            <!-- 3. Робимо рамку товщою (було 1) та трохи світлішою для контрасту -->
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="BorderBrush" Value="#555"/> 
            
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Background" Value="#000000"/> 
            <Setter Property="Foreground" Value="#888"/> 
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
        
        <!-- Hover state for virtual macropad buttons -->
        <Style Selector="Button.deck-btn:pointerover /template/ ContentPresenter">
            <!-- Зберігаємо товщину рамки при наведенні, змінюємо лише колір -->
            <Setter Property="BorderBrush" Value="#4CAF50"/>
            <Setter Property="Background" Value="#000000"/>
        </Style>
    </Window.Styles>
</Window>
